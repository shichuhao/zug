# ============================================================
# 凭据与配置 —— 绝不能入库
# 注意：目标仓库是 PUBLIC，secrets/ 下是 zugfinder 账号的邮箱+密码，
#       .env 里有运行配置。任何一项泄露都是实打实的安全事故。
# ============================================================
secrets/
*.bak-*
.env
.env.*
!.env.example          # 示例模板不含真实值，保留
*.pem
*.key
*.p12
*.pfx
*credential*
*account*.txt
*password*
*_secret*
token*.json

# ============================================================
# 大数据 / 模型 / 依赖（data/ 约 19GB：模型 + parquet + 抓取缓存）
# ============================================================
data/
.venv/
venv/
node_modules/
__pycache__/
*.py[cod]
*.egg-info/
.cache/

# 归档包：可能内含 secrets/，一律排除
*.tar.gz
*.tgz
*.zip
*.7z
*.rar

# ============================================================
# 日志与运行产物
# ============================================================
*.log
*.log.*
logs/
tmp/
temp/
.DS_Store
Thumbs.db
