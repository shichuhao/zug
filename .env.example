# Node server
PORT=3000
PYTHON_BIN=python3

# Optional external data directories on the deployment host
DELAY_MODEL_DIR=/opt/traindelay-data/delay_model
PIEBRO_DIR=/opt/traindelay-data/piebro
IMPACT_DATA_DIR=/opt/traindelay-data/impact
ZUGFINDER_PRO_DIR=/opt/traindelay-data/zugfinder_pro
ZUGFINDER_CRED=/opt/traindelay-data/account.txt

# Optional runtime settings
SHARE_TTL_DAYS=30
PREDICTION_CACHE_TTL_MS=120000
PREDICTION_CACHE_MAX_ENTRIES=100

# 行程链接中转（可选，优先级低于 SOCKS5）
# bahnapp.link 用 CloudFront WAF 按来源 IP 封禁，机房 IP 被封时整站取不到。
# 在 Cloudflare Workers / Deno Deploy 上部署一个转发（见 bahnapp-worker/README.md），
# 用云厂商的 IP 去取页面。不填 = 走直连。
#   ZUGFINDER_RELAY_URL=https://bahnapp-relay.<你的子域>.workers.dev/
#   ZUGFINDER_RELAY_TOKEN=<与 Worker 的 AUTH_TOKEN 保持一致>
ZUGFINDER_RELAY_URL=
ZUGFINDER_RELAY_TOKEN=

# 行程链接抓取出口代理（可选，优先级最高）
# 推荐方案：把请求从**住宅/移动 IP** 出去，比任何机房 IP 都更难被 WAF 识别。
# 实测 Cloudflare 的数据中心 IP 段同样在 bahnapp 的黑名单里，
# 所以中转方案不总是奏效；而手机移动网络/家庭宽带可以稳定取到真实页面。
# 填了它就优先走这里，格式 socks5:// 或 socks5h://（后者让代理侧解析 DNS）。
# 例：tailscaled --tun=userspace-networking --socks5-server=127.0.0.1:1080
#     tailscale set --exit-node=<手机在内网的地址>
#
# ⚠️ 反模式（2026-09-21 实测证伪，勿重试）：bahnapp 用 CloudFront WAF 按
#   【客户端出口 IP】封禁，与目标 IP / 请求头无关：
#     · 改 hosts、逐个换 CloudFront 边缘 IP（--resolve）→ 全被拦；
#     · 伪造 iPhone UA / Accept-Language: de-DE → 仍被拦；
#     · 沙箱直连出口是腾讯云 CN（AS45090）→ 必拦；住宅/移动 IP → 放行。
#   唯一出路 = 换一个非中国大陆的出口 IP。改 host / 换 IP / 改头都没用。
ZUGFINDER_SOCKS5=

# 追加出口池（可选）。逗号分隔，可带 #名称@ 前缀便于识别与日志。
#   语法: [#名称@]socks5h://host:port[, ...]   （带 scheme 或裸 host:port 均可）
#   ⚠️ 必须单行！.env 与 server.js 均为逐行解析，换行会被截断。
# 用途：主出口（如一台手机）离线时自动切到备用出口，消除单点。
#   ZUGFINDER_SOCKS5_EXTRA=#note12@socks5h://127.0.0.1:1081,#vps@socks5h://10.0.0.5:1080
ZUGFINDER_SOCKS5_EXTRA=

# 出口池开关：=0 时忽略 EXTRA，只用主出口（旧行为）。
JOURNEY_SOCKS_POOL_ON=1

# 出口健康主动探测（默认开）。提前发现出口掉线，使故障转移瞬时发生。
#   INTERVAL=0 关闭；FAIL_THRESHOLD=连续失败几次标 unhealthy；
#   PROBE_URL=探测目标（用真实业务路径，能反映 WAF 是否放行该出口）。
JOURNEY_PROBE_INTERVAL_MS=90000
JOURNEY_PROBE_FAIL_THRESHOLD=2
JOURNEY_PROBE_URL=https://bahnapp.online/route

# 逐出口熔断（默认 3 次失败 / 60s 冷却）。一个出口熔断不影响其他出口。
JOURNEY_PROXY_FAIL_THRESHOLD=3
JOURNEY_PROXY_COOLDOWN_MS=60000

# 通道回退链（默认 socks,relay，**不含 direct**）。
# direct 走部署机 CN IP，必被 bahnapp WAF 拦，只会多等几秒并给出误导性结果。
# 需要直连（如本地联调）时显式加回：socks,relay,direct
JOURNEY_CHANNEL_FALLBACK=socks,relay

# 排查行程抓取问题时打开，会打印每次抓取的跳转、HTTP 码、页面字节数与结构命中数
# JOURNEY_DEBUG=1

# 运行期可查：
#   GET /api/debug            → journeyChannels.egresses 看每个出口健康/熔断/最近用哪条通道
#   GET /api/health           → checks.journey_proxy 看出口池整体健康

